# Copy this file to .env and fill it in. `npm run setup` will do it for you.

# Token from @BotFather after `/newbot`.
TELEGRAM_BOT_TOKEN=

# NOTE: the whitelist lives in users.json, not here -- it maps Telegram user
# IDs to real people and doubles as the list of who may talk to the bot.
# Copy users.example.json to users.json and fill it in.

# Path to your wiki folder -- the directory the bot runs Claude Code inside.
# `~` and relative paths are expanded. Examples:
#   macOS / Linux:  HOMEWIKI_PATH=~/Documents/HomeWiki
#   Windows:        HOMEWIKI_PATH=C:\Users\you\OneDrive\HomeWiki
# Don't have one yet? `npm run setup` can scaffold it from template/.
HOMEWIKI_PATH=

# Path to the Claude Code CLI. Leave as "claude" if `claude --version` works in
# your terminal. Set the full path if it isn't on PATH -- which is common when
# the bot is started by a scheduled task or launchd rather than by you:
#   macOS / Linux:  CLAUDE_BIN=/Users/you/.local/bin/claude
#   Windows:        CLAUDE_BIN=C:\Users\you\.local\bin\claude.exe
CLAUDE_BIN=claude
